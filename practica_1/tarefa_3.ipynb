      "source": [
        "# 5. Mapas de Similaridade (Atención Visual)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "2266bed4",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
