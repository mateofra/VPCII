        "# Indexación con DINO"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "79f94c56",
      "metadata": {
        "id": "79f94c56",
        "outputId": "5ba9e961-bb05-4a48-a176-e7ac3a898995"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "\n",
            "Extraendo características co modelo DINO...\n"
          ]
        },
        {
          "name": "stderr",
          "output_type": "stream",
          "text": [
            "Indexando DINO: 100%|██████████| 391/391 [04:29<00:00,  1.45it/s]\n"
          ]
        }
      ],
      "source": [
        "def index_dino(model, dataloader):\n",
        "    features_list = []\n",
        "    labels_list = []\n",
        "    with torch.inference_mode():\n",
        "        for imgs, labels in tqdm(dataloader, desc=\"Indexamos a DINO\"):\n",
        "            imgs = imgs.to(device)\n",
        "            outputs = model(imgs)\n",
        "            # DINO tamén usa o CLS token para a representación global\n",
        "            feats = outputs.last_hidden_state[:, 0, :]\n",
        "            feats = F.normalize(feats, p=2, dim=1)\n",
        "            features_list.append(feats.cpu())\n",
        "            labels_list.append(labels)\n",
        "    return torch.cat(features_list), torch.cat(labels_list)\n",
        "\n",
        "feats_dino, labels_dino = index_dino(model_dino, loader)"
      ]
    },
