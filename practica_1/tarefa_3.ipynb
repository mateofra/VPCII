      "source": [
        "# 4. Avaliación e Comparación"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "id": "65c25bbf",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "65c25bbf",
        "outputId": "8dfd7c11-59b2-47e9-f929-d5934b14b285"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "DINO (ViT-B16) -> Precision k5: 0.7836\n"
          ]
        }
      ],
      "source": [
        "def avaliacion(features, labels, k=5):\n",
        "    features = F.normalize(features, p=2, dim=1)\n",
        "    matriz_sim = torch.mm(features, features.t())\n",
        "    matriz_sim.fill_diagonal_(-1)\n",
        "    _, topk_indices = torch.topk(matriz_sim, k, dim=1)\n",
        "    etiquetas_query = labels.view(-1, 1).expand_as(topk_indices)\n",
        "    etiquetas_mellores = labels[topk_indices]\n",
        "    precision_k = (etiquetas_query == etiquetas_mellores).float().mean().item()\n",
        "    return precision_k\n",
        "\n",
        "p_dino = avaliacion(feats_dino, labels_dino, k=5)\n",
        "\n",
        "print(f\"DINO (ViT-B16) -> Precision k5: {p_dino:.4f}\")\n"
      ]
    },
