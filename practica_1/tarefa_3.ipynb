        },
        "id": "2266bed4",
        "outputId": "0486e4ed-4266-4e0a-aa44-68698f35d9d1"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "\tMapas de similaridade:\n"
          ]
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1500x800 with 8 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
